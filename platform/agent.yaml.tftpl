#cloud-config
# The agent VM's first boot: the web interface and its service, which starts one agent per request
# (your checkout's agent/). build/infra/compute.tf renders this file. cloud-init runs it once: it
# writes the files, installs the packages, then runs runcmd.
# https://github.com/canonical/cloud-init/blob/26.2/config/cloud.cfg.tmpl (as-of 2026-11-02)
#
# This VM holds only its own credentials: the inference key, a read-only token and the agent's forge
# identity, which can push its own branches but can neither approve nor merge.

package_update: true
packages:
  - python3-venv  # the service's environment, on Ubuntu 24.04's Python 3.12

# Every file lands root-owned, since the agent user doesn't exist until runcmd. The files this VM
# runs come from the files bucket, since user data can't hold them: the API refuses more than 16,384
# bytes of it, decoded. The manifest lists each one's SHA-256, so a change to any of them changes
# the user data, which replaces the VM.
# https://github.com/canonical/cloud-init/blob/26.2/cloudinit/config/cc_write_files.py (as-of 2026-11-02)
write_files:
  # First boot's fetch, the one script user data carries, gzipped (gz+b64).
  - path: /opt/agentic-iac/platform/fetch-files.sh
    permissions: "0755"
    encoding: gz+b64
    content: ${base64gzip(file("${repo_root}/platform/fetch-files.sh"))}

  # The files bucket and this VM's own read-only key to it, which only root reads, to fetch.
  - path: /etc/agentic-iac/files.env
    permissions: "0400"
    content: |
      FILES_ENDPOINT=${files_endpoint}
      FILES_BUCKET=${files_bucket}
      FILES_ACCESS_KEY=${agent_files_access_key}
      FILES_SECRET_KEY=${agent_files_secret_key}

  # What this VM runs from your checkout, by mode, SHA-256 and path (build/infra/compute.tf): the
  # service, read-only to it, and the OpenTofu install.
  - path: /etc/agentic-iac/files.manifest
    permissions: "0644"
    content: |
%{ for name, mode in agent_files ~}
      ${mode} ${filesha256("${repo_root}/${name}")} ${name}
%{ endfor ~}

  # The service's settings and secrets, for the agent user alone. The forge is the platform VM, over
  # the private network; the platform creates reader/infra. CrewAI's telemetry and tracing stay off,
  # so a run calls no host but the model's endpoint, the forge and the Linode API.
  # https://docs.crewai.com/en/telemetry (as-of 2026-10-29)
  - path: /etc/agentic-iac/agent.env
    permissions: "0400"
    content: |
      INFERENCE_ENDPOINT=${inference_endpoint}
      INFERENCE_MODEL=${inference_model}
      INFERENCE_API_KEY=${inference_api_key}
      LINODE_TOKEN=${agent_token}
      LINODE_PROVIDER_VERSION=${linode_provider_version}
      FORGE_URL=${forge_url}
      FORGE_USER=${forge_agent_user}
      FORGE_PASSWORD=${forge_agent_password}
      FORGE_REPO=reader/infra
      CREWAI_DISABLE_TELEMETRY=true
      CREWAI_TRACING_ENABLED=false

  # Runs from /opt/agentic-iac, so agent.app imports, and each run's process (python -m agent.runner)
  # finds the same package. Each run keeps its records under the agent user's home. The validate tool
  # runs tofu from PATH with the local mirror's CLI config.
  # https://github.com/encode/uvicorn/blob/0.54.0/docs/settings.md (as-of 2026-11-02)
  - path: /etc/systemd/system/agent.service
    permissions: "0644"
    content: |
      [Unit]
      Description=The web interface: ask the agent for a change
      Wants=network-online.target
      After=network-online.target

      [Service]
      User=agent
      Group=agent
      WorkingDirectory=/opt/agentic-iac
      EnvironmentFile=/etc/agentic-iac/agent.env
      Environment=TF_CLI_CONFIG_FILE=/opt/agentic-iac/tofu.tfrc
      ExecStart=/opt/agentic-iac/venv/bin/uvicorn agent.app:app --host 0.0.0.0 --port ${web_port}
      Restart=on-failure

      [Install]
      WantedBy=multi-user.target

# One /bin/sh script, a line per item, run once as root after the packages.
runcmd:
  - set -e  # stop at the first failure, so that `cloud-init status` reports it
  # First, every file this VM runs, each checked against its SHA-256 in the manifest.
  - [/opt/agentic-iac/platform/fetch-files.sh, /etc/agentic-iac/files.env, /etc/agentic-iac/files.manifest, /opt/agentic-iac]
  # The service's user, with a writable home, owning only its own settings and secrets.
  - [useradd, --system, --create-home, --home-dir, /var/lib/agent, --shell, /usr/sbin/nologin, agent]
  - [chown, "agent:agent", /etc/agentic-iac/agent.env]
  - [/opt/agentic-iac/platform/install-tofu.sh, "${opentofu_version}", "${linode_provider_version}"]
  # The pinned set from agent/requirements.txt, with the module's pins beside it: pip refuses the
  # install if the two disagree.
  # ASSUMPTION (unverified): the pinned set installs on Ubuntu 24.04 in 2 GB.
  - [python3, -m, venv, /opt/agentic-iac/venv]
  - [/opt/agentic-iac/venv/bin/pip, install, --requirement, /opt/agentic-iac/agent/requirements.txt%{ for library, version in python_libraries }, "${library}==${version}"%{ endfor }]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, agent.service]
  - [curl, -fsS, --retry, "30", --retry-delay, "2", --retry-connrefused, -o, /dev/null, "http://127.0.0.1:${web_port}/"]
