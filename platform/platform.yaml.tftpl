#cloud-config
# The platform VM's first boot: the forge (Gitea), the pipeline (Atlantis) and the policy engine
# (Conftest), with the gate's code check, policies and server-side config from your checkout's gate/.
# build/infra/compute.tf renders this file. cloud-init runs it once: it writes the files, installs
# the packages, then runs runcmd.
# https://github.com/canonical/cloud-init/blob/26.2/config/cloud.cfg.tmpl (as-of 2026-11-02)
#
# This VM alone holds the pipeline's credentials: the read-write token and the state bucket's keys.
# Anything running on a VM can read its user data from the metadata service, without a credential,
# which is why the agent runs on a VM of its own.
# https://techdocs.akamai.com/cloud-computing/docs/access-the-metadata-service-api (as-of 2026-10-29)

package_update: true
packages:
  - git    # Atlantis clones each change
  - unzip  # Atlantis ships as a zip, and Canonical's Ubuntu 24.04 image has no unzip

# Every file lands root-owned, since the service users don't exist until runcmd. Embedded files are
# gzipped (gz+b64): user data can't exceed 65,535 bytes base64-encoded. A change to any of them
# changes the user data, which replaces the VM.
# https://github.com/canonical/cloud-init/blob/26.2/cloudinit/config/cc_write_files.py (as-of 2026-11-02)
write_files:
  # The gate, verbatim. Atlantis reads it and can't change it, and its scripts are executable: the
  # plan workflow runs init-shard.sh by path.
%{ for name in fileset("${repo_root}/gate", "**") ~}
  - path: /opt/agentic-iac/gate/${name}
    permissions: "${endswith(name, ".sh") ? "0755" : "0644"}"
    encoding: gz+b64
    content: ${base64gzip(file("${repo_root}/gate/${name}"))}
%{ endfor ~}
  # First boot's scripts, and the shard teardown, which only root may run.
%{ for name in ["install-tofu.sh", "setup-platform.sh", "teardown-shards.sh"] ~}
  - path: /opt/agentic-iac/platform/${name}
    permissions: "${name == "teardown-shards.sh" ? "0700" : "0755"}"
    encoding: gz+b64
    content: ${base64gzip(file("${repo_root}/platform/${name}"))}
%{ endfor ~}

  # Atlantis's settings and secrets, for the atlantis user alone. Its environment outranks
  # gate/server.yaml, which sets none of these. setup-platform.sh adds the forge token it mints.
  # https://github.com/runatlantis/atlantis/blob/v0.49.0/runatlantis.io/docs/server-configuration.md (as-of 2026-11-02)
  - path: /etc/agentic-iac/atlantis.env
    permissions: "0400"
    content: |
      ATLANTIS_GITEA_BASE_URL=http://127.0.0.1:${forge_port}
      ATLANTIS_GITEA_USER=${forge_pipeline_user}
      ATLANTIS_GITEA_WEBHOOK_SECRET=${webhook_secret}
      ATLANTIS_REPO_ALLOWLIST=*/${forge_reader_user}/infra
      ATLANTIS_ATLANTIS_URL=http://127.0.0.1:4141
      ATLANTIS_PORT=4141
      ATLANTIS_DEFAULT_TF_DISTRIBUTION=opentofu
      ATLANTIS_DEFAULT_TF_VERSION=${opentofu_version}
      ATLANTIS_TF_DOWNLOAD=false
      TF_CLI_CONFIG_FILE=/opt/agentic-iac/tofu.tfrc
      LINODE_TOKEN=${pipeline_token}
      LINODE_PROVIDER_VERSION=${linode_provider_version}
      AWS_ACCESS_KEY_ID=${state_access_key}
      AWS_SECRET_ACCESS_KEY=${state_secret_key}
      STATE_BUCKET=${state_bucket}
      STATE_ENDPOINT=${state_endpoint}
      ADMIN_RANGE=${reader_cidr}

  # The forge's identities and their passwords, which only root reads, to create them.
  - path: /etc/agentic-iac/forge-users.env
    permissions: "0400"
    content: |
      FORGE_READER_USER=${forge_reader_user}
      FORGE_READER_PASSWORD=${forge_reader_password}
      FORGE_AGENT_USER=${forge_agent_user}
      FORGE_AGENT_PASSWORD=${forge_agent_password}
      FORGE_PIPELINE_USER=${forge_pipeline_user}
      FORGE_PIPELINE_PASSWORD=${forge_pipeline_password}

  # Its port is opened to your range and the private network. Gitea finds WORK_PATH in its config.
  - path: /etc/systemd/system/gitea.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Gitea, the forge
      Wants=network-online.target
      After=network-online.target

      [Service]
      User=gitea
      Group=gitea
      ExecStart=/usr/local/bin/gitea --config /etc/gitea/app.ini web
      Restart=on-failure

      [Install]
      WantedBy=multi-user.target

  # Atlantis's port is never opened in the firewall: the forge calls it on loopback, so its own pages
  # (the links in its statuses) open only through an SSH tunnel.
  - path: /etc/systemd/system/atlantis.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Atlantis, the pipeline: plans, checks and applies the change repository's pull requests
      Wants=network-online.target
      After=network-online.target gitea.service

      [Service]
      User=atlantis
      Group=atlantis
      EnvironmentFile=/etc/agentic-iac/atlantis.env
      ExecStart=/usr/local/bin/atlantis server --config /opt/agentic-iac/gate/server.yaml
      Restart=on-failure

      [Install]
      WantedBy=multi-user.target

# One /bin/sh script, a line per item, run once as root after the packages.
runcmd:
  - set -e  # stop at the first failure, so that `cloud-init status` reports it
  # Each service gets its own user, with a home, owning only its own files.
  - [useradd, --system, --create-home, --home-dir, /var/lib/gitea, --shell, /usr/sbin/nologin, gitea]
  - [useradd, --system, --create-home, --home-dir, /var/lib/atlantis, --shell, /usr/sbin/nologin, atlantis]
  - [chown, "atlantis:atlantis", /etc/agentic-iac/atlantis.env]
  - [/opt/agentic-iac/platform/install-tofu.sh, "${opentofu_version}", "${linode_provider_version}"]
  - [/opt/agentic-iac/platform/setup-platform.sh, "${gitea_version}", "${atlantis_version}", "${conftest_version}", "${forge_port}"]
